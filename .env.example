# ==============================================================================
# SCHOLAR LENS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Institutional Research Management & Analytics Platform
# NOTE: Safe placeholders only. Never commit production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# In production, generate a cryptographically strong 50+ character random key:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-this-in-production-use-strong-50char-random-key
DEBUG=False
SITE_NAME="Scholar Lens"
SITE_URL=https://scholar-lens.university.edu
TIME_ZONE=UTC

# Comma-separated list of fully qualified hostnames/domains permitted to serve requests
ALLOWED_HOSTS=scholar-lens.university.edu,staging-scholar-lens.university.edu,localhost,127.0.0.1

# Comma-separated list of origins trusted for CSRF protection (must include protocol and port if non-standard)
CSRF_TRUSTED_ORIGINS=https://scholar-lens.university.edu,https://staging-scholar-lens.university.edu

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Primary standard connection URL (overrides separate DB_* variables if supplied):
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgres://scholar_lens:your_secure_password_here@127.0.0.1:5432/scholar_lens

# Alternative discrete database variables (active when USE_POSTGRES=True and DATABASE_URL is unset):
USE_POSTGRES=True
DB_NAME=scholar_lens
DB_USER=scholar_lens
DB_PASSWORD=your_secure_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. HTTP SECURITY & SSL HARDENING (Active when DEBUG=False)
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SINGLE SIGN-ON (Google OAuth 2.0 / OpenID Connect)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
# Exact registered redirect URI matching Google Console configuration:
GOOGLE_OAUTH_REDIRECT_URI=https://scholar-lens.university.edu/accounts/google/callback/

# ------------------------------------------------------------------------------
# 5. AI & NATURAL LANGUAGE ENGINE (OpenAI API / RAG)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 6. EXTERNAL SCHOLARLY HARVESTING APIS
# ------------------------------------------------------------------------------
# SerpAPI for Google Scholar queries (optional fallback to rule-based parser)
SERPAPI_API_KEY=
SCHOLAR_API_PROVIDER=serpapi
SCHOLAR_API_TIMEOUT=10
SCHOLAR_MAX_RESULTS=5

# Elsevier Scopus API (optional institutional license key for enriched citation indexing)
SCOPUS_API_KEY=

# ------------------------------------------------------------------------------
# 7. ASSET, STORAGE & FILE UPLOADS
# ------------------------------------------------------------------------------
# Maximum file upload limit for researcher CVs, paper PDFs, and project proposals (in MB)
MAX_UPLOAD_SIZE_MB=20

# ------------------------------------------------------------------------------
# 8. P08 MODULE THRESHOLDS & SCHEDULING
# ------------------------------------------------------------------------------
# Milestone and funding deadline notification triggers (days prior to deadline)
FUNDING_ALERT_DAYS=30,14,7,1
MILESTONE_AT_RISK_DAYS=7
MILESTONE_AT_RISK_PROGRESS=50

# ------------------------------------------------------------------------------
# 9. TESTING & AUTOMATION MODES (Never enable in Production)
# ------------------------------------------------------------------------------
E2E=False

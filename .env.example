# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database (PostgreSQL - used when USE_POSTGRES=True)
USE_POSTGRES=False
DATABASE_URL=postgres://scholar_lens:scholar_lens@localhost:5432/scholar_lens
DB_NAME=scholar_lens
DB_USER=scholar_lens
DB_PASSWORD=scholar_lens
DB_HOST=localhost
DB_PORT=5432

# AI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Scholar Integration
SERPAPI_API_KEY=
SCHOLAR_API_TIMEOUT=10
SCHOLAR_MAX_RESULTS=5

# File Upload
MAX_UPLOAD_SIZE_MB=20

# Application
SITE_NAME=Scholar Lens
SITE_URL=http://localhost:8000
